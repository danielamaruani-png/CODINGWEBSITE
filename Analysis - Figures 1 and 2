    {
      "cell_type": "code",
      "source": [
        "# -------------------------------------------------\n",
        "# FOLLOW-UP DOT PLOT\n",
        "# Light blue = NFB | Yellow = MBI\n",
        "# Same y-axis limits as post-treatment\n",
        "# -------------------------------------------------\n",
        "\n",
        "# 1) Y-axis limits based on POST-TREATMENT values\n",
        "post_nfb = [0.222, 0.080, -0.490]\n",
        "post_mbi = [0.320, None, 0.770]\n",
        "\n",
        "all_post = [v for v in post_nfb if v is not None] + [v for v in post_mbi if v is not None]\n",
        "ymin, ymax = min(all_post), max(all_post)\n",
        "\n",
        "pad = 0.10 * (ymax - ymin)\n",
        "ymin -= pad\n",
        "ymax += pad\n",
        "\n",
        "# 2) FOLLOW-UP data\n",
        "domains = [\"Inattention / Attention\", \"Hyperactivity / Impulsivity\", \"ADHD overall\"]\n",
        "\n",
        "nfb_mean = [0.678, 0.610, None]\n",
        "nfb_k    = [5,     1,     0]\n",
        "\n",
        "mbi_mean = [0.370, 0.640, 0.340]\n",
        "mbi_k    = [1,     1,     1]\n",
        "\n",
        "# 3) Plot\n",
        "x = list(range(len(domains)))\n",
        "offset = 0.12\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(10, 5))\n",
        "\n",
        "# Reference line at zero\n",
        "ax.axhline(0, linewidth=1)\n",
        "\n",
        "# Colours\n",
        "nfb_color = \"#6EC1E4\"   # light blue\n",
        "mbi_color = \"#F4D03F\"   # yellow\n",
        "\n",
        "# Neurofeedback (NFB)\n",
        "for i, (m, ki) in enumerate(zip(nfb_mean, nfb_k)):\n",
        "    if m is None or ki == 0:\n",
        "        continue\n",
        "    ax.scatter(x[i] - offset, m, s=80, color=nfb_color,\n",
        "               label=\"Neurofeedback (NFB)\" if i == 0 else None)\n",
        "    ax.text(x[i] - offset, m, f\" k={ki}\", va=\"center\", ha=\"left\", fontsize=10)\n",
        "\n",
        "# Mindfulness-Based Interventions (MBI)\n",
        "for i, (m, ki) in enumerate(zip(mbi_mean, mbi_k)):\n",
        "    if m is None or ki == 0:\n",
        "        continue\n",
        "    ax.scatter(x[i] + offset, m, s=80, color=mbi_color,\n",
        "               label=\"Mindfulness-based interventions (MBI)\" if i == 0 else None)\n",
        "    ax.text(x[i] + offset, m, f\" k={ki}\", va=\"center\", ha=\"left\", fontsize=10)\n",
        "\n",
        "# Formatting\n",
        "ax.set_xticks(x)\n",
        "ax.set_xticklabels(domains, rotation=20, ha=\"right\")\n",
        "ax.set_ylabel(\"Mean standardised effect size (Hedges' g)\")\n",
        "ax.set_title(\"Follow-up mean effect sizes by symptom domain (dot plot)\")\n",
        "\n",
        "# Same y-axis limits as post-treatment\n",
        "ax.set_ylim(ymin, ymax)\n",
        "\n",
        "ax.legend(frameon=False)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Optional save\n",
