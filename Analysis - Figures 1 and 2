    {
      "cell_type": "code",
      "source": [
        "\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "domains = [\"Inattention / Attention\", \"Hyperactivity / Impulsivity\", \"ADHD overall\"]\n",
        "\n",
        "nfb_mean = [0.222, 0.080, -0.490]\n",
        "nfb_k    = [6,     2,     1]\n",
        "\n",
        "mbi_mean = [0.320, None,  0.770]\n",
        "mbi_k    = [1,     0,     1]\n",
        "\n",
        "x = np.arange(len(domains))\n",
        "offset = 0.12\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(10, 5))\n",
        "\n",
        "\n",
        "ax.axhline(0, linewidth=1)\n",
        "\n",
        "ax.scatter(x - offset, nfb_mean, s=80, label=\"Neurofeedback (NFB)\")\n",
        "\n",
        "for xi, yi, ki in zip(x - offset, nfb_mean, nfb_k):\n",
        "    ax.text(xi, yi, f\" k={ki}\", va=\"center\", ha=\"left\", fontsize=10)\n",
        "\n",
        "for i, (m, ki) in enumerate(zip(mbi_mean, mbi_k)):\n",
        "    if m is None or ki == 0:\n",
        "        continue\n",
        "    ax.scatter(x[i] + offset, m, s=80, label=\"Mindfulness-based interventions (MBI)\" if i == 0 else None)\n",
        "    ax.text(x[i] + offset, m, f\" k={ki}\", va=\"center\", ha=\"left\", fontsize=10)\n",
        "\n",
        "ax.set_xticks(x)\n",
        "ax.set_xticklabels(domains, rotation=20, ha=\"right\")\n",
        "ax.set_ylabel(\"Mean standardised effect size (Hedges' g)\")\n",
        "ax.set_title(\"Post-treatment mean effect sizes by symptom domain (dot plot)\")\n",
        "\n",
        "ax.legend(frameon=False)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ],
