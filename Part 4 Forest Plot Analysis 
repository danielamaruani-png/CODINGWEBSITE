        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Load data\n",
        "post_df = pd.read_csv(\"/content/POST_TREATMENT_clean_final.csv\")\n",
        "\n",
        "# Colours (as agreed)\n",
        "NFB_COLOR = \"#F4D03F\"   # yellow\n",
        "MBI_COLOR = \"#2ECC71\"   # green\n",
        "\n",
        "# Keep required columns only\n",
        "df = post_df.dropna(subset=[\"effect_value\", \"CI_low\", \"CI_high\", \"method\"]).copy()\n",
        "\n",
        "# Order: NFB first, then MBI\n",
        "df[\"method_order\"] = df[\"method\"].map({\"NFB\": 0, \"MBI\": 1})\n",
        "df = df.sort_values(\"method_order\").reset_index(drop=True)\n",
        "\n",
        "# Create labels (NFB-01, NFB-02, MBI-01, ...)\n",
        "labels = []\n",
        "counts = {\"NFB\": 0, \"MBI\": 0}\n",
        "for m in df[\"method\"]:\n",
        "    counts[m] += 1\n",
        "    labels.append(f\"{m}-{counts[m]:02d}\")\n",
        "df[\"label\"] = labels\n",
        "\n",
        "# Y positions\n",
        "y = np.arange(len(df))[::-1]\n",
        "\n",
        "# Plot\n",
        "fig, ax = plt.subplots(figsize=(10, 5.5))\n",
        "ax.axvline(0, linestyle=\"--\", linewidth=1)\n",
        "\n",
        "for yi, (_, row) in zip(y, df.iterrows()):\n",
        "    color = NFB_COLOR if row[\"method\"] == \"NFB\" else MBI_COLOR\n",
        "    ax.plot([row[\"CI_low\"], row[\"CI_high\"]], [yi, yi], color=color, linewidth=2)\n",
        "    ax.scatter(row[\"effect_value\"], yi, color=color, s=55, zorder=3)\n",
        "\n",
        "# Axes and title\n",
        "ax.set_yticks(y)\n",
        "ax.set_yticklabels(df[\"label\"])\n",
        "ax.set_xlabel(\"Standardised effect size (Hedges' g)\")\n",
        "ax.set_title(\"Forest plot — Post-treatment effects (descriptive)\")\n",
        "\n",
        "# Legend\n",
        "ax.scatter([], [], color=NFB_COLOR, label=\"Neurofeedback (NFB)\")\n",
        "ax.scatter([], [], color=MBI_COLOR, label=\"Mindfulness-based interventions (MBI)\")\n",
        "ax.legend(frameon=False, loc=\"lower right\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
