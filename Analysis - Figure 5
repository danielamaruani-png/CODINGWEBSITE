        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# --- Data ---\n",
        "domains = [\"Inattention / Attention\", \"Hyperactivity / Impulsivity\", \"ADHD overall\"]\n",
        "\n",
        "data = pd.DataFrame({\n",
        "    \"Domain\": domains,\n",
        "    \"NFB Post\":      [0.222, 0.080, -0.490],\n",
        "    \"NFB Follow-up\": [0.678, 0.610, np.nan],\n",
        "    \"MBI Post\":      [0.320, np.nan, 0.770],\n",
        "    \"MBI Follow-up\": [0.370, 0.640, 0.340]\n",
        "})\n",
        "\n",
        "# --- Plot ---\n",
        "x = np.arange(len(domains))\n",
        "width = 0.2\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(11, 5))\n",
        "\n",
        "ax.bar(x - 1.5*width, data[\"NFB Post\"],      width,\n",
        "       label=\"NFB Post-treatment\", color=\"#1f77b4\")\n",
        "ax.bar(x - 0.5*width, data[\"NFB Follow-up\"], width,\n",
        "       label=\"NFB Follow-up (6–12 months)\", color=\"#aec7e8\")\n",
        "ax.bar(x + 0.5*width, data[\"MBI Post\"],      width,\n",
        "       label=\"MBI Post-treatment\", color=\"#ff7f0e\")\n",
        "ax.bar(x + 1.5*width, data[\"MBI Follow-up\"], width,\n",
        "       label=\"MBI Follow-up (6–12 months)\", color=\"#ffdd57\")\n",
        "\n",
        "ax.axhline(0, linewidth=1)\n",
        "ax.set_xticks(x)\n",
        "ax.set_xticklabels(domains, rotation=15, ha=\"right\")\n",
        "ax.set_ylabel(\"Mean Hedges' g\")\n",
        "ax.set_title(\"Mean effects by symptom domain, intervention, and timepoint\")\n",
        "ax.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    }
