      "source": [
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. Chargement et préparation\n",
        "df_post = pd.read_csv('/content/POST_TREATMENT_clean_final.csv')\n",
        "df_fu = pd.read_csv('/content/FOLLOW_UP_6_13M_clean_final.csv')\n",
        "df_post.columns = df_post.columns.str.strip()\n",
        "df_fu.columns = df_fu.columns.str.strip()\n",
        "\n",
        "df_all = pd.concat([df_post, df_fu], ignore_index=True)\n",
        "df_all['effect_value'] = pd.to_numeric(df_all['effect_value'], errors='coerce')\n",
        "\n",
        "# Mapping des couleurs demandé\n",
        "custom_palette = {\"NFB\": \"#1f77b4\", \"MBI\": \"#ff7f0e\"} # Bleu et Orange\n",
        "\n",
        "# --- FIGURE 1 : Boxplots of Effect Sizes ---\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.boxplot(data=df_all, x='time_category', y='effect_value', hue='method',\n",
        "            palette=custom_palette, width=0.6)\n",
        "plt.title('Figure 1: Distribution of Effect Sizes at T1 and T2', fontsize=14)\n",
        "plt.ylabel('Standardized Effect Size (Hedges’ g)')\n",
        "plt.xlabel('Timepoint')\n",
        "plt.tight_layout()\n",
        "plt.savefig('boxplot_distribution.png', dpi=300)\n",
        "\n",
        "# --- FIGURE 2 : Temporal Line Plot ---\n",
        "plt.figure(figsize=(10, 6))\n",
        "# On calcule la moyenne pour chaque groupe à chaque temps\n",
        "line_data = df_all.groupby(['time_category', 'method'])['effect_value'].mean().reset_index()\n",
        "\n",
        "# Pour que l'axe X soit dans l'ordre chronologique\n",
        "line_data['time_category'] = pd.Categorical(line_data['time_category'],\n",
        "                                            categories=['Post-treatment', 'Follow-up (6–13 months)'],\n",
        "                                            ordered=True)\n",
        "line_data = line_data.sort_values('time_category')\n",
        "\n",
        "sns.lineplot(data=line_data, x='time_category', y='effect_value', hue='method',\n",
        "             palette=custom_palette, marker='o', markersize=10, linewidth=3)\n",
        "\n",
        "plt.title('Figure 2: Mean Effect Size Trajectory (T1 → T2)', fontsize=14)\n",
        "plt.ylabel('Mean Effect Size (g)')\n",
        "plt.xlabel('Timepoint')\n",
        "plt.ylim(0, 1) # Ajuster selon tes données\n",
        "plt.grid(True, linestyle='--', alpha=0.6)\n",
        "plt.tight_layout()\n",
        "plt.savefig('temporal_trajectory.png', dpi=300)\n",
        "\n",
        "plt.show()"
